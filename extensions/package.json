{
  "name": "rvow-extensions",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck:pi": "tsc --noEmit -p pi",
    "typecheck:claude": "node scripts/claude.mjs tsc",
    "validate:claude": "node scripts/claude.mjs validate",
    "test:claude": "node scripts/claude.mjs test",
    "drift": "node scripts/drift.mjs",
    "check": "npm run drift && npm run lint && npm run typecheck:pi && npm run typecheck:claude && npm run validate:claude && npm run test:claude"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  },
  "claudeCodeTypes": "2.1.287"
}
