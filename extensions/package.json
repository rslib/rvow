{
  "name": "rvow-extensions",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check --error-on-warnings .",
    "typecheck:pi": "tsc --noEmit -p pi",
    "test:pi": "node --test pi/*.test.ts",
    "test:pi:tools": "node --test pi/audit-tools.test.ts",
    "test:pi:dock": "node --test pi/audit-dock.test.ts",
    "typecheck:claude": "node scripts/claude.mjs tsc",
    "validate:claude": "node scripts/claude.mjs validate",
    "test:claude": "node scripts/claude.mjs test",
    "check": "npm run lint && npm run typecheck:pi && npm run test:pi && npm run typecheck:claude && npm run validate:claude && npm run test:claude"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
